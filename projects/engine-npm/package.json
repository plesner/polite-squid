{
  "name": "@posqui/engine",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc && mkdir -p dist/wasm && cp src/wasm/engine.mjs src/wasm/engine.wasm src/wasm/engine.d.mts dist/wasm/",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.23.0"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
